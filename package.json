{
  "name": "climbing-beta-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite --host 0.0.0.0\" \"tsx watch server/index.ts\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:production": "PLAYWRIGHT_BASE_URL=http://127.0.0.1:3001 PLAYWRIGHT_EXTERNAL=1 playwright test",
    "test:export": "tsx tests/server-export-smoke.ts",
    "check": "npm run test && npm run build",
    "install:browser": "playwright install chromium"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^10.1.5",
    "fastify": "^5.0.0",
    "fflate": "^0.8.2",
    "idb": "^8.0.0",
    "mediabunny": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^9.0.0",
    "dotenv": "^16.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
