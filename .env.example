# Server only. deepseek-flash supports image input through Chat Completions.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
PORT=3001
FFMPEG_PATH=ffmpeg
# Optional: system Chromium path. Otherwise uses Playwright's installed Chromium.
CHROMIUM_EXECUTABLE_PATH=
EXPORT_TTL_MINUTES=30
